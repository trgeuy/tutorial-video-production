<!doctype html>
<!--
  Two replayed terminal captures on one desktop (duokit). Every frame in each window is a
  REAL screen from a capture, replayed through pyte by tools/rec2frames.py; build.py only sets the
  timing, the placement, which window is in front, and the name substitutions. Chrome and default
  colours match screenkit; the back window is drawn inactive, as macOS draws it (grey buttons, dim title).
-->
<html lang="en" data-resolution="landscape">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1920px; height: 1080px; overflow: hidden; background: #3a4150; }
      #root {
        width: 100%; height: 100%; position: relative;
        background: radial-gradient(ellipse at 30% 20%, #56607a 0%, #2c3140 70%);
      }
      .win {
        position: absolute; border-radius: 11px; overflow: hidden;
        background: #1c222c; border: 1px solid #3b3f46; display: flex; flex-direction: column;
        box-shadow: 0 26px 70px rgba(0,0,0,.6);
      }
      .win.inactive { box-shadow: 0 14px 40px rgba(0,0,0,.42); }
      .bar {
        height: 34px; background: #232323; position: relative; flex: none;
        display: flex; align-items: center; justify-content: center;
        font: 500 15px -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif; color: #a5a5a5;
      }
      .win.inactive .bar { background: #282828; color: #6f6f6f; }
      .dots { position: absolute; left: 13px; top: 11px; display: flex; gap: 8px; }
      .dots i { width: 12px; height: 12px; border-radius: 50%; display: block; }
      .win.inactive .dots i { background: #4a4a4a !important; box-shadow: inset 0 0 0 1px #5a5a5a; }
      .term {
        flex: none; padding: 10px 13px; overflow: hidden; position: relative;
        line-height: 1.36; font-family: ui-monospace, "SF Mono", Menlo, monospace; color: #dadcdc;
        white-space: pre; font-variant-ligatures: none; font-feature-settings: "calt" 0, "liga" 0;
      }
      .probe { position: absolute; visibility: hidden; white-space: pre; }
      /* A run with its own background fills the whole line height, as a terminal draws it (an inline span's
         background covers only the font box: a dark line between rows of Claude Code's sent-message band). */
      .term span[style*="background"] { display: inline-block; vertical-align: top; }
      .caption {
        position: absolute; left: 50%; bottom: 40px; transform: translateX(-50%); opacity: 0;
        background: rgba(16,18,24,.92); color: #f2f2f2; border: 1px solid #4a5060; border-radius: 12px;
        padding: 16px 28px; font: 500 28px -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
        box-shadow: 0 16px 50px rgba(0,0,0,.5); white-space: nowrap; z-index: 50;
      }
      .caption code { font: 24px ui-monospace, "SF Mono", Menlo, monospace; color: #ffd27a; }
      .still {
        position: absolute; opacity: 0; z-index: 40; border-radius: 10px; background: #fff;
        box-shadow: 0 24px 70px rgba(0,0,0,.6), 0 0 0 1px rgba(0,0,0,.35);
      }
      .callout {
        position: absolute; border: 3px solid #ff9f0a; border-radius: 7px; opacity: 0;
        box-shadow: 0 0 0 4px rgba(255,159,10,.25); pointer-events: none;
      }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="%%DUR%%"
         data-width="1920" data-height="1080">
      <div id="desk" class="clip" data-start="0" data-duration="%%DUR%%" data-track-index="0"
           style="position:absolute;inset:0"></div>
      <div id="dip" style="position:absolute;inset:0;background:#000;opacity:0;z-index:60;pointer-events:none"></div>
      %%AUDIO%%
    </div>
    <script>
      // ---- GENERATED by duokit/build.py from spec.json + the frames files -- do not edit. ----
      const D = %%DATA%%;
      const desk = document.getElementById("desk");
      const wins = D.windows.map((w, n) => {
        const el = document.createElement("div");
        el.className = "win"; el.id = "w" + n;
        el.style.left = w.x + "px"; el.style.top = w.y + "px";
        el.innerHTML = '<div class="bar"><div class="dots"><i style="background:#ff5f57"></i>' +
          '<i style="background:#febc2e"></i><i style="background:#28c840"></i></div><span class="title"></span></div>' +
          '<div class="term"><div class="screen"></div><span class="probe">MMMMMMMMMM</span></div>';
        desk.appendChild(el);
        const term = el.querySelector(".term");
        term.style.fontSize = w.font + "px";
        // The font family is set HERE, on the element: set only in the stylesheet (.term), the render showed a
        // proportional font (seen in our renders; these windows are made at run time).
        // Menlo is what screenkit's #term resolves to in the render, so both kits look the same.
        term.style.fontFamily = 'Menlo, "SF Mono", monospace';
        const cw = el.querySelector(".probe").getBoundingClientRect().width / 10;
        const lh = parseFloat(getComputedStyle(term).lineHeight);
        const pad = { x: parseFloat(getComputedStyle(term).paddingLeft), y: parseFloat(getComputedStyle(term).paddingTop) };
        term.style.width = (w.cols * cw + 2 * pad.x) + "px";
        term.style.height = (w.rows * lh + 2 * pad.y) + "px";
        return { w, el, term, scr: el.querySelector(".screen"), title: el.querySelector(".title"), cw, lh, pad, shown: -1 };
      });

      const boxes = D.callouts.map((c) => {
        const W = wins[c.win], b = document.createElement("div");
        b.className = "callout";
        b.style.left = (W.pad.x + c.c0 * W.cw - 6) + "px";
        b.style.top = (W.pad.y + c.r * W.lh - 3) + "px";
        b.style.width = ((c.c1 - c.c0 + 1) * W.cw + 12) + "px";
        b.style.height = (W.lh + 6) + "px";
        W.term.appendChild(b);
        return b;
      });
      const caps = D.captions.map((c) => {
        const b = document.createElement("div");
        b.className = "caption"; b.innerHTML = c.html;
        document.getElementById("root").appendChild(b);
        return b;
      });

      const pics = (D.stills || []).map((c) => {
        const b = document.createElement("img");
        b.className = "still"; b.src = c.src;
        Object.assign(b.style, { left: c.x + "px", top: c.y + "px", width: c.w + "px" });
        document.getElementById("root").appendChild(b);
        return b;
      });

      let front = -1;
      function render(t) {
        for (const W of wins) {
          let k = W.w.timeline[0][1];
          for (const [v, i] of W.w.timeline) { if (v <= t) k = i; else break; }
          if (k !== W.shown) { W.scr.innerHTML = W.w.frames[String(k)]; W.shown = k; }
          let ttl = W.w.titles[0][1];
          for (const [v, x] of W.w.titles) { if (v <= t) ttl = x; else break; }
          if (W.title.textContent !== ttl) W.title.textContent = ttl;
        }
        let f = D.focus[0][1];
        for (const [v, i] of D.focus) { if (v <= t) f = i; else break; }
        if (f !== front) {
          wins.forEach((W, n) => { W.el.style.zIndex = n === f ? 20 : 10; W.el.classList.toggle("inactive", n !== f); });
          front = f;
        }
      }

      const tl = gsap.timeline({ paused: true });
      // Dips to black at a cut (spec segment `dip`), as screenkit: out before the segment, in from its start.
      (D.dips || []).forEach((d) => {
        tl.to("#dip", { opacity: 1, duration: d.dur, ease: "none" }, d.at - d.dur);
        tl.to("#dip", { opacity: 0, duration: d.dur, ease: "none" }, d.at);
      });
      tl.fromTo("#desk", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 0);
      D.callouts.forEach((c, i) => {
        tl.to(boxes[i], { opacity: 1, duration: 0.3 }, c.at);
        tl.to(boxes[i], { opacity: 0, duration: 0.3 }, c.at + c.dur);
      });
      D.captions.forEach((c, i) => {
        tl.fromTo(caps[i], { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.35 }, c.at);
        tl.to(caps[i], { opacity: 0, duration: 0.3 }, c.at + c.dur);
      });
      (D.stills || []).forEach((c, i) => {
        tl.fromTo(pics[i], { opacity: 0, scale: 0.97 }, { opacity: 1, scale: 1, duration: 0.4, ease: "power2.out" }, c.at);
        tl.to(pics[i], { opacity: 0, duration: 0.4 }, c.at + c.dur);
      });
      const clock = { t: 0 };
      tl.to(clock, { t: %%DUR%%, duration: %%DUR%%, ease: "none", onUpdate: () => render(clock.t) }, 0);
      window.__timelines = window.__timelines || {};
      window.__timelines["main"] = tl;
      // index.html#t=12.5 shows the frame at 12.5 s (for stills; the renderer ignores the hash).
      const still = location.hash.match(/t=([\d.]+)/);
      if (still) { const t = parseFloat(still[1]); tl.seek(t); render(t); gsap.set("#desk", { opacity: 1, y: 0 }); }
      else { render(0); tl.seek(0); }
    </script>
  </body>
</html>
