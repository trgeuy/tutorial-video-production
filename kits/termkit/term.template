<!doctype html>
<!--
  Simulated macOS Terminal session (termkit).
  All command output comes from spec.json, where it is REAL captured output. Colours sampled from
  captures/dryrun2-frames/frame-0243.png.
-->
<html lang="en" data-resolution="landscape">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1920px; height: 1080px; overflow: hidden; background: #3a4150; }
      #root {
        width: 100%; height: 100%; position: relative;
        background: radial-gradient(ellipse at 30% 20%, #56607a 0%, #2c3140 70%);
        display: flex; align-items: center; justify-content: center;
      }
      #win {
        width: 1700px; height: 960px; border-radius: 12px; overflow: hidden; position: relative;
        background: #1c222c; box-shadow: 0 30px 80px rgba(0,0,0,.55);
        border: 1px solid #3b3f46; display: flex; flex-direction: column;
      }
      #bar {
        height: 40px; background: #232323; position: relative; flex: none;
        display: flex; align-items: center; justify-content: center;
        font: 500 17px -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif; color: #a5a5a5;
      }
      .dots { position: absolute; left: 16px; top: 13px; display: flex; gap: 9px; }
      .dots i { width: 14px; height: 14px; border-radius: 50%; display: block; }
      #term {
        flex: 1; padding: 14px 18px; overflow: hidden;
        font: 22px/1.36 ui-monospace, "SF Mono", Menlo, monospace; color: #dadcdc;
        white-space: pre; display: block; font-variant-ligatures: none; font-feature-settings: "calt" 0, "liga" 0;
      }
      .cur { background: #dadcdc; color: #1c222c; }
      #key {
        position: absolute; right: 40px; bottom: 36px; opacity: 0;
        padding: 14px 26px; border-radius: 12px; background: rgba(250,250,250,.95); color: #1d1d1f;
        font: 600 30px -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
        box-shadow: 0 6px 0 #9a9a9a, 0 12px 30px rgba(0,0,0,.45);
      }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="%%DUR%%"
         data-width="1920" data-height="1080">
      <div id="win" class="clip" data-start="0" data-duration="%%DUR%%" data-track-index="0">
        <div id="bar">
          <div class="dots"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i></div>
          <span id="title"></span>
        </div>
        <div id="term"></div>
        <div id="key"></div>
      </div>
      %%AUDIO%%
    </div>
    <script>
      // ---- GENERATED by termkit/build.py from spec.json -- edit spec.json, not index.html. ----
      const CPS = %%CPS%%;       // typing speed, characters per second (steady)
      const ENTER_LAG = %%LAG%%; // pause between the last keystroke and the output appearing
      const ROWS = 29;           // visible rows; older lines scroll off the top
      const USER = %%USER%%, HOST = %%HOST%%, FINAL_DIR = %%FINAL_DIR%%;
      const shellP = (dir) => `${USER}@${HOST} ${dir} % `;
      const promptOf = (s) => (s.prompt !== undefined ? s.prompt : shellP(s.dir));
      const steps = %%STEPS%%;
      const defaultTitle = (dir) => `${dir === "~" ? USER : dir} — -zsh — 120×30`;

      const term = document.getElementById("term");
      const title = document.getElementById("title");
      const esc = (s) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;");

      function render(t) {
        const lines = [];
        let cursorLine = null, dir = "~", winTitle = null;
        for (let i = 0; i < steps.length; i++) {
          const s = steps[i];
          if (t < s.at) { cursorLine = promptOf(s); break; }
          if (s.dir) dir = s.dir;
          const typed = Math.min(s.cmd.length, Math.floor((t - s.at) * CPS));
          const shown = (n) => (s.hidden ? "" : s.cmd.slice(0, n));
          const typeEnd = s.at + s.cmd.length / CPS;
          if (typed < s.cmd.length || t < typeEnd + ENTER_LAG) { cursorLine = promptOf(s) + shown(typed); break; }
          // Terminal shows the program in the title only once it runs, not while it is typed.
          if (s.title !== undefined) winTitle = s.title;
          lines.push(promptOf(s) + shown(s.cmd.length));
          lines.push(...s.out);
          if (s.late) {
            if (t < typeEnd + ENTER_LAG + s.late.after) { cursorLine = ""; break; }
            lines.push(...s.late.lines);
          }
          if (i === steps.length - 1) {
            cursorLine = FINAL_DIR !== null ? shellP(FINAL_DIR) : "";
            if (FINAL_DIR !== null) { dir = FINAL_DIR; winTitle = null; }
          }
        }
        title.textContent = winTitle !== null ? winTitle : defaultTitle(dir);
        const all = lines.map(esc);
        if (cursorLine !== null) all.push(esc(cursorLine) + '<span class="cur"> </span>');
        term.innerHTML = all.slice(-ROWS).join("\n");
      }

      const tl = gsap.timeline({ paused: true });
      tl.fromTo("#win", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 0);
      const clock = { t: 0 };
      tl.to(clock, { t: %%DUR%%, duration: %%DUR%%, ease: "none", onUpdate: () => render(clock.t) }, 0);
      // Keycaps for keys Terminal does not echo (Control-E, Return).
      const keyEl = document.getElementById("key");
      for (const s of steps) {
        if (!s.key) continue;
        tl.call(() => { keyEl.textContent = s.key; }, null, s.at - 0.35);
        tl.fromTo("#key", { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.2 }, s.at - 0.35);
        tl.to("#key", { opacity: 0, duration: 0.25 }, s.at + 1.2);
      }
      window.__timelines = window.__timelines || {};
      window.__timelines["main"] = tl;
      render(0);
      tl.seek(0);
    </script>
  </body>
</html>
