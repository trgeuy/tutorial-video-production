<!doctype html>
<!--
  Replayed terminal capture (screenkit). Every frame is a REAL screen from a `script -r`
  capture, replayed through pyte by tools/rec2frames.py; build.py only sets the timing and the
  name substitutions. Window chrome and default colours match termkit.
-->
<html lang="en" data-resolution="landscape">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1920px; height: 1080px; overflow: hidden; background: #3a4150; }
      #root {
        width: 100%; height: 100%; position: relative;
        background: radial-gradient(ellipse at 30% 20%, #56607a 0%, #2c3140 70%);
        display: flex; align-items: center; justify-content: center;
      }
      #win {
        width: 1700px; height: 960px; border-radius: 12px; overflow: hidden; position: relative;
        background: #1c222c; box-shadow: 0 30px 80px rgba(0,0,0,.55);
        border: 1px solid #3b3f46; display: flex; flex-direction: column;
      }
      #bar {
        height: 40px; background: #232323; position: relative; flex: none;
        display: flex; align-items: center; justify-content: center;
        font: 500 17px -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif; color: #a5a5a5;
      }
      .dots { position: absolute; left: 16px; top: 13px; display: flex; gap: 9px; }
      .dots i { width: 14px; height: 14px; border-radius: 50%; display: block; }
      #term {
        flex: 1; padding: 14px 18px; overflow: hidden; position: relative;
        font: 22px/1.36 ui-monospace, "SF Mono", Menlo, monospace; color: #dadcdc;
        white-space: pre; display: block; font-variant-ligatures: none; font-feature-settings: "calt" 0, "liga" 0;
      }
      #probe { position: absolute; visibility: hidden; white-space: pre; }
      .caption {
        position: absolute; left: 50%; bottom: 70px; transform: translateX(-50%); opacity: 0;
        background: rgba(16,18,24,.92); color: #f2f2f2; border: 1px solid #4a5060; border-radius: 12px;
        padding: 18px 30px; font: 500 30px -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif;
        box-shadow: 0 16px 50px rgba(0,0,0,.5); white-space: nowrap; z-index: 4;
      }
      .caption code { font: 26px ui-monospace, "SF Mono", Menlo, monospace; color: #ffd27a; }
      .overlay { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); opacity: 0; z-index: 5; }
      .callout {
        position: absolute; border: 3px solid #ff9f0a; border-radius: 8px; opacity: 0;
        box-shadow: 0 0 0 4px rgba(255,159,10,.25); pointer-events: none;
      }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="%%DUR%%"
         data-width="1920" data-height="1080">
      <div id="win" class="clip" data-start="0" data-duration="%%DUR%%" data-track-index="0">
        <div id="bar">
          <div class="dots"><i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i></div>
          <span id="title"></span>
        </div>
        <div id="term"><div id="screen"></div><span id="probe">MMMMMMMMMM</span></div>
      </div>
      %%OVERLAYS%%
      <div id="dip" style="position:absolute;inset:0;background:#000;opacity:0;z-index:20;pointer-events:none"></div>
      %%AUDIO%%
    </div>
    <script>
      // ---- GENERATED by screenkit/build.py from spec.json + the frames file -- do not edit. ----
      const D = %%DATA%%;
      const titleEl = document.getElementById("title");
      const scr = document.getElementById("screen"), term = document.getElementById("term");
      // A capture that is not 120x30 (e.g. an 80x24 console): a bigger font, and the window sized to the grid,
      // as a real Terminal window of that size looks. 120x30 beats keep the fixed 1700x960 window.
      if (D.fit) term.style.fontSize = D.fit.font + "px";
      const probe = document.getElementById("probe");
      const cw = probe.getBoundingClientRect().width / 10;
      const lh = parseFloat(getComputedStyle(term).lineHeight);
      const pad = { x: parseFloat(getComputedStyle(term).paddingLeft), y: parseFloat(getComputedStyle(term).paddingTop) };
      if (D.fit) {
        const win = document.getElementById("win");
        win.style.width = Math.ceil(2 * pad.x + D.cols * cw + 2) + "px";
        win.style.height = Math.ceil(40 + 2 * pad.y + D.rows * lh + 2) + "px";
      }

      // Callout boxes, placed on the character grid.
      const boxes = D.callouts.map((c) => {
        const b = document.createElement("div");
        b.className = "callout";
        b.style.left = (pad.x + c.c0 * cw - 8) + "px";
        b.style.top = (pad.y + c.r0 * lh - 4) + "px";
        b.style.width = ((c.c1 - c.c0 + 1) * cw + 16) + "px";
        b.style.height = ((c.r1 - c.r0 + 1) * lh + 8) + "px";
        term.appendChild(b);
        return b;
      });

      const caps = D.captions.map((c) => {
        const b = document.createElement("div");
        b.className = "caption"; b.innerHTML = c.html;
        document.getElementById("root").appendChild(b);
        return b;
      });
      let shown = -1;
      function render(t) {
        let k = D.timeline[0][1];
        for (const [v, i] of D.timeline) { if (v <= t) k = i; else break; }
        if (k !== shown) { scr.innerHTML = D.frames[String(k)]; shown = k; }
        let ttl = D.titles[0][1];
        for (const [v, x] of D.titles) { if (v <= t) ttl = x; else break; }
        if (titleEl.textContent !== ttl) titleEl.textContent = ttl;
      }

      const tl = gsap.timeline({ paused: true });
      tl.fromTo("#win", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.5, ease: "power2.out" }, 0);
      // Dips to black at a cut (spec segment `dip`): out before the segment, in from its start.
      (D.dips || []).forEach((d) => {
        tl.to("#dip", { opacity: 1, duration: d.dur, ease: "none" }, d.at - d.dur);
        tl.to("#dip", { opacity: 0, duration: d.dur, ease: "none" }, d.at);
      });
      D.callouts.forEach((c, i) => {
        tl.to(boxes[i], { opacity: 1, duration: 0.3 }, c.at);
        tl.to(boxes[i], { opacity: 0, duration: 0.3 }, c.at + c.dur);
      });
      D.captions.forEach((c, i) => {
        tl.fromTo(caps[i], { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.35 }, c.at);
        tl.to(caps[i], { opacity: 0, duration: 0.3 }, c.at + c.dur);
      });
      (D.overlays || []).forEach((o, i) => {
        tl.fromTo("#ov" + i, { opacity: 0 }, { opacity: 1, duration: 0.25 }, o.at);
        tl.to("#ov" + i, { opacity: 0, duration: 0.25 }, o.at + o.dur);
      });
      const clock = { t: 0 };
      tl.to(clock, { t: %%DUR%%, duration: %%DUR%%, ease: "none", onUpdate: () => render(clock.t) }, 0);
      window.__timelines = window.__timelines || {};
      window.__timelines["main"] = tl;
      // index.html#t=12.5 shows the frame at 12.5 s (for stills; the renderer ignores the hash).
      const still = location.hash.match(/t=([\d.]+)/);
      if (still) { const t = parseFloat(still[1]); tl.seek(t); render(t); gsap.set("#win", { opacity: 1, y: 0 }); }
      else { render(0); tl.seek(0); }
    </script>
  </body>
</html>
