<!doctype html>
<!-- Title card (cardkit). Text comes from spec.json via build.py. -->
<html lang="en" data-resolution="landscape">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1920px; height: 1080px; overflow: hidden; background: #2c3140; }
      #root {
        width: 100%; height: 100%; position: relative; color: #f2f2f2;
        background: radial-gradient(ellipse at 30% 20%, #56607a 0%, #2c3140 70%);
        font-family: -apple-system, "SF Pro Display", "Helvetica Neue", sans-serif;
      }
      #box { position: absolute; left: 180px; right: 180px; top: 330px; }
      #title { font-size: 76px; font-weight: 700; letter-spacing: -1px; line-height: 1.1; opacity: 0; }
      #sub { margin-top: 26px; font-size: 44px; font-weight: 400; color: #c9cfdc; opacity: 0; }
      #rule { margin-top: 44px; width: 0; height: 4px; background: #e0463a; border-radius: 2px; }
      .line { margin-top: 30px; font-size: 34px; color: #dfe3ea; opacity: 0; }
      .line code { font-family: "SF Mono", Menlo, monospace; font-size: 31px; color: #ffffff; background: #2a3240; padding: 2px 10px; border-radius: 6px; }
      %%EXTRA_CSS%%
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="%%DUR%%"
         data-width="1920" data-height="1080">
      <div id="box" class="clip" data-start="0" data-duration="%%DUR%%" data-track-index="0">
        <div id="title">%%TITLE%%</div>
        <div id="sub">%%SUB%%</div>
        <div id="rule"></div>
        %%LINES%%
      </div>
      %%AUDIO%%
    </div>
    <script>
      // ---- GENERATED by cardkit/build.py from spec.json. ----
      const LINES = %%LINE_TIMES%%;
      const tl = gsap.timeline({ paused: true });
      tl.fromTo("#title", { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" }, 0.2);
      tl.fromTo("#sub", { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" }, 0.6);
      tl.to("#rule", { width: 220, duration: 0.6, ease: "power2.out" }, 0.9);
      LINES.forEach((t, i) => tl.fromTo(`#line${i}`, { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: 0.5 }, t));
      window.__timelines = window.__timelines || {};
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
